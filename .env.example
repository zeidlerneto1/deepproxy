# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional)
API_KEY=sua-chave-secreta-aqui

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Usar um navegador já instalado via canal do Playwright (evita baixar Chromium).
# Valores comuns: "chrome" (Chrome do sistema) ou "msedge" (Edge do sistema).
# Deixe vazio para usar o Chromium incluído no Playwright.
# PLAYWRIGHT_CHANNEL=chrome

# Relaxar a verificação TLS na conexão ao chat.deepseek.com (apenas para redes
# confiáveis). Útil quando um antivírus/firewall com inspeção SSL injeta um cert
# auto-assinado de forma intermitente e causa erros SELF_SIGNED_CERT_IN_CHAIN.
# DEEPSPROXY_INSECURE_TLS=true

# Resiliência contra erros upstream intermitentes do DeepSeek.
# Número máximo de tentativas por requisição (default: 3).
# DEEPSPROXY_MAX_ATTEMPTS=4
# Delay base (ms) do backoff exponencial entre tentativas (1s * 2^tentativa).
# DEEPSPROXY_RETRY_BACKOFF_MS=1000
# Timeout (ms) aguardando o primeiro chunk do stream antes de considerar falha.
# DEEPSPROXY_FIRST_CHUNK_TIMEOUT_MS=15000

# Estabilidade da sessão (evita navegar o browser a cada request).
# TTL do cache de headers/PoW capturados via Playwright (ms). Enquanto válido,
# as requisições reutilizam a sessão sem reabrir/navegar no browser. Default: 5 min.
# DEEPSPROXY_HEADERS_TTL_MS=300000
# Caminho do arquivo JSON que persiste a sessão capturada (sobrevive a reinícios).
# Default: deepseek_profile/session_headers.json
# DEEPSPROXY_HEADERS_FILE=deepseek_profile/session_headers.json

# Descoberta dinâmica de modelos (limites reais de contexto via /client/settings).
# Intervalo de refresh em ms (default: 1h). Se a consulta falhar, mantém os caps manuais.
# DEEPSPROXY_MODELS_REFRESH_MS=3600000
# Teto máximo (em tokens) para um limite descoberto (protege contra valores
# absurdos/corrompidos de input_character_limit re-inflarem o contexto). Default: 1000000.
# DEEPSPROXY_MODELS_MAX_TOKENS=1000000

# Logging
LOG_LEVEL=info
